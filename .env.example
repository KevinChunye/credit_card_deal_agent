# Copy to .env for local development, or set as environment variables in
# Maritime's agent settings. Never commit real values.
# The code reads os.environ only; it never loads this file itself. Locally:
#   set -a; . ./.env; set +a

# --- AgentMail (personal offers inbox + digest email) ---
AGENTMAIL_API_KEY=
# The inbox address, e.g. kev_work@agentmail.to (AgentMail's inbox_id is the address).
AGENTMAIL_INBOX=

# --- Who the agent may email / trust ---
# Your own address. Mail forwarded from it is accepted by `inbox poll`, and the
# digest may only ever be sent here or to DIGEST_TO_EMAIL.
OWNER_EMAIL=
# Optional: where the monthly digest email goes (defaults to OWNER_EMAIL).
DIGEST_TO_EMAIL=

# --- Snapshot source (the collector's `data` branch) ---
# Only needed if the repository is private (fine-grained PAT, read-only "Contents").
GITHUB_TOKEN=
# Defaults shown; override only if you fork or rename.
CARD_AGENT_DATA_REPO=KevinChunye/credit_card_deal_agent
CARD_AGENT_DATA_BRANCH=data

# --- Private local state ---
# SQLite DB with your profile, wallet and personal offers. Defaults to
# ~/.credit_card_deal_agent/state.db. The snapshot cache lives next to it.
CARD_AGENT_DB=

# Repo root that bin/card-agent cds into (defaults to the script's parent dir).
CARD_AGENT_HOME=
